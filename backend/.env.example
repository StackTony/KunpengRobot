# 环境配置示例 (复制为 .env 后修改)
# ---- 基础 ----
DEBUG=false
SECRET_KEY=CHANGE-ME-USE-RANDOM-STRING

# ---- 数据库 (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://kunpeng:kunpeng@localhost:5432/kunpeng

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 存储 ----
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=2048

# ---- Worker ----
WORKER_CONCURRENCY=8
WORKER_CONSUMER_NAME=worker-1

# ---- LLM (OpenAI 兼容 API, 留空则降级为纯规则分析) ----
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CONCURRENCY=4

# ---- 指标 ----
METRIC_RETENTION_DAYS=90
